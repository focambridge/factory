# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging and builds
build/
dist/
*.egg-info/
.eggs/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Factory working area (run worktrees, demo workspace)
work/

# Logs and runtime data
logs/
*.log
*.pid

# Environment and secrets
.env
.env.*
!.env.example

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Factory console: keep the built web app, ignore its dependencies
console/web/node_modules/
!console/web/dist/

# Projects are personal: each person's projects stay on their own machine.
# The folder itself is kept so the factory has somewhere to put new projects.
projects/*
!projects/README.md
